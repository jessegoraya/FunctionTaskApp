{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "CosmosDBConnection": "AccountEndpoint=https://localhost:8081/;AccountKey=YOUR_KEY_HERE;",
    "TenantCosmosDatabaseName": "bloomskyHealth",
    "TenantCosmosContainerName": "Tenant",
    "ProjectCosmosDatabaseName": "bloomskyHealth",
    "ProjectCosmosContainerName": "Project",
    "TenantEmailIngestionStateContainerName": "TenantEmailIngestion",
    "TenantEmailIngestionQueueName": "tenant-email-extraction",
    "TenantEmailIngestion__AllowDirectPayloads": "true",
    "TenantEmailIngestion__ClientStateSigningKey": "local-development-only",
    "TenantEmailIngestion__FoundryAgentEndpoint": "https://your-project.services.ai.azure.com/api/projects/your-project/agents/taslow-email-extraction/versions/1/endpoint/protocols/invocations?api-version=v1",
    "TenantEmailIngestion__ProjectServiceEndpoint": "https://your-apim.azure-api.net/FunctionProjectApp",
    "TenantEmailIngestion__TaskServiceEndpoint": "https://your-apim.azure-api.net/FunctionTaskApp",
    "TenantEmailIngestion__LogicAppEndpoint": "https://your-region.logic.azure.com/workflows/your-workflow/triggers/request/paths/invoke",
    "TenantEmailIngestion__MinimumTaskWriteConfidence": "0.80",
    "Auth:Environment": "development",
    "Auth:Issuer": "taslow-dev-auth",
    "Auth:Audience": "taslow-api",
    "Auth:EnableSyntheticLogin": "true",
    "Auth:SessionLifetimeMinutes": "480",
    "Auth:CookieName": "taslow_auth",
    "Auth:CookieSecure": "false",
    "Auth:JwtSigningKey": "taslow-development-auth-signing-key-change-before-production",
    "Auth:ProviderStateSigningKey": "taslow-development-provider-state-signing-key-change-before-production",
    "Auth:WebAppBaseUrl": "http://localhost:5173",
    "Auth:Microsoft:ClientId": "",
    "Auth:Microsoft:ClientSecret": "",
    "Auth:Microsoft:RedirectUri": "http://localhost:7074/api/auth/callback/microsoft",
    "Auth:Microsoft:Scopes": "openid profile email User.Read",
    "Auth:Microsoft:IntegratedInternalDomains:<tenant_id>": "customer.onmicrosoft.com,customer.com",
    "Auth:Microsoft:IntegratedUsers:<tenant_id>": "Customer User <user@customer.onmicrosoft.com>",
    "Auth:AuditContainerName": "AuthenticationAudit",
    "TenantAuth:EnableDevHeaders": "true",
    "TenantIntegration:EnableProviderAutomation": "false"
  }
}
